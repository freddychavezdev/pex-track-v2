<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="match_parent">
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">
  <TextView
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="PEX Track"
    android:textColor="#182230"
    android:textSize="28sp"
    android:textStyle="bold" />
  <TextView
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="20dp"
    android:text="Acceso de técnico"
    android:textColor="#182230"
    android:textSize="18sp"
    android:textStyle="bold" />
  <EditText
    android:id="@+id/emailInput"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:autofillHints="emailAddress"
    android:hint="Correo institucional"
    android:inputType="textEmailAddress" />
  <EditText
    android:id="@+id/passwordInput"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:autofillHints="password"
    android:hint="Contraseña"
    android:inputType="textPassword" />
  <Button
    android:id="@+id/loginButton"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:text="Iniciar sesión" />
  <Button
    android:id="@+id/signOutButton"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:text="Cerrar sesión" />
  <TextView
    android:id="@+id/statusText"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="16dp"
    android:text="Seguimiento detenido"
    android:textColor="#5F7086"
    android:textSize="16sp" />
  <Button
    android:id="@+id/startTrackingButton"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="32dp"
    android:text="Iniciar seguimiento" />
  <Button
    android:id="@+id/stopTrackingButton"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:text="Detener seguimiento" />
  <TextView
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="28dp"
    android:text="Órdenes asignadas"
    android:textColor="#182230"
    android:textSize="18sp"
    android:textStyle="bold" />
  <Button
    android:id="@+id/refreshWorkOrdersButton"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:text="Actualizar OTs" />
  <EditText
    android:id="@+id/suspensionReasonInput"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:hint="Motivo de suspensión (obligatorio al suspender)"
    android:inputType="textCapSentences|textMultiLine" />
  <LinearLayout
    android:id="@+id/workOrdersContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical" />
  </LinearLayout>
</ScrollView>
